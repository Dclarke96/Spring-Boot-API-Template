###########################################

# PostgreSQL / Docker Configuration

###########################################

# Used by PostgreSQL/Docker to initialize the database.

POSTGRES_DB=springboot_template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

###########################################

# Spring Boot Database Configuration

###########################################

# Used by Spring Boot to connect to PostgreSQL.

DB_URL=jdbc:postgresql://localhost:5432/springboot_template
DB_USERNAME=postgres
DB_PASSWORD=change-me

###########################################

# JWT Configuration

###########################################

# Generate a secure random secret before production use.

# Never commit real secrets to source control.

JWT_SECRET=replace-with-a-long-random-secret

###########################################

# Spring Profile Configuration

###########################################

# Available profiles:

# local  - Local development

# test   - Automated testing

# docker - Docker environment

# prod   - Production deployment

SPRING_PROFILES_ACTIVE=local
